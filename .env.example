# PostgreSQL stores users, profiles, jobs, applications, match scores, and
# pgvector embeddings during the MVP.
POSTGRES_DB=aijobs
POSTGRES_USER=aijobs
POSTGRES_PASSWORD=aijobs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis is reserved for rate limits, short-lived cache, and future async job
# coordination. Do not store durable hiring data here.
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO is the local S3-compatible object store for resume files.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=resumes

# Grafana is local-only in this scaffold. Change the password if sharing the
# environment on a network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Replace this before any real auth testing. Keep secrets out of git.
JWT_SECRET=replace-with-a-long-random-secret

# AI provider selection. Keep provider-specific code behind client interfaces.
AI_PROVIDER=openai
OPENAI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
